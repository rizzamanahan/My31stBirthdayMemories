rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /birthday/{type}/{id}/{filename} {
   allow read: if true;
   allow write: if request.auth != null && request.auth.uid == 'REPLACE_WITH_ADMIN_UID'
    && request.resource.size < 250 * 1024 * 1024
    && request.resource.contentType.matches('image/.*|video/.*');
   allow delete: if request.auth != null && request.auth.uid == 'REPLACE_WITH_ADMIN_UID';
  }
 }
}
